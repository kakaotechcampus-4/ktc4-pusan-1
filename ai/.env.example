APP_ENV=local
LOG_LEVEL=INFO

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANALYSIS_TIMEOUT_SECONDS=30

ELICE_API_KEY=
ELICE_STT_BASE_URL=
ELICE_STT_MODEL=whisper-large-v3
ELICE_STT_LANGUAGE=korean
ELICE_STT_TIMEOUT_SECONDS=60

# Project LLM (Elice ML API serverless). Timeline generation uses these.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60

# Backend internal API (/internal/v1). Agent -> BE suggestion delivery and
# BE -> Agent interview context, over HTTP.
BACKEND_BASE_URL=
BACKEND_API_KEY=
BACKEND_TIMEOUT_SECONDS=10

# Transcript WebSocket. Its address is derived from BACKEND_BASE_URL, so there
# is no second URL to set. All three values are provisional: the ACK wait,
# buffer cap and reconnect policy are not agreed with Backend yet.
TRANSCRIPT_ACK_TIMEOUT_SECONDS=5
TRANSCRIPT_MAX_PENDING=200
TRANSCRIPT_RECONNECT_BACKOFF_SECONDS=0.5
