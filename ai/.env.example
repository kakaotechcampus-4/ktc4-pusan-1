APP_ENV=local
LOG_LEVEL=INFO

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANALYSIS_TIMEOUT_SECONDS=30

ELICE_API_KEY=
ELICE_STT_BASE_URL=
ELICE_STT_MODEL=whisper-large-v3
ELICE_STT_LANGUAGE=ko
ELICE_STT_TIMEOUT_SECONDS=60
STT_REQUEST_DEADLINE_SECONDS=15

# Live STT provider: elice (default) or deepgram. Setting a key alone does
# not switch providers.
STT_PROVIDER=elice
DEEPGRAM_API_KEY=

# Project LLM (Elice ML API serverless). Timeline generation uses these.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60

# Backend internal API (/internal/v1). Agent -> BE suggestion delivery and
# BE -> Agent interview context, over HTTP.
BACKEND_BASE_URL=
BACKEND_API_KEY=
BACKEND_TIMEOUT_SECONDS=10

# Prep poller (irya-ai-poller, #176). Seconds between asks when the queue is
# empty, and how long to leave a job alone after this process failed on it.
PREP_POLL_INTERVAL_SECONDS=5
PREP_RETRY_AFTER_SECONDS=30
# A REVIEW is retried only while the retry can still finish this many seconds
# after the request. Same as Backend's SUMMARY_TIMEOUT_SECONDS.
REVIEW_DEADLINE_SECONDS=180
# REPORT 처리 한도. BE의 REPORT_TIMEOUT_SECONDS와 동일하게 맞춘다.
REPORT_TIMEOUT_SECONDS=180

# Transcript WebSocket. Its address is derived from BACKEND_BASE_URL, so there
# is no second URL to set. All three values are provisional: the ACK wait,
# buffer cap and reconnect policy are not agreed with Backend yet.
TRANSCRIPT_ACK_TIMEOUT_SECONDS=5
TRANSCRIPT_MAX_PENDING=200
TRANSCRIPT_RECONNECT_BACKOFF_SECONDS=0.5

# ── 최종 발표 데모 ────────────────────────────────────────
# Stage-demo utterance injection. The backend hands the worker a scripted
# candidate answer and the worker puts it into the real pipeline as a FINAL
# candidate utterance - captions, storage and follow-up questions all run the
# production path from there. Only "the candidate made a sound" is replaced.
#
# Both are needed: the flag arms this worker, the list says which rooms it may
# touch (comma separated session ids).
#
# ⚠️ A listed session's transcript can hold speech nobody said. Name the demo
# session and nothing else, and turn it back off afterwards. An empty list
# allows no room at all, so the flag on its own cannot open every interview on
# the host. Backend's two values have to match.
DEMO_INJECTION_ENABLED=false
DEMO_INJECTION_SESSIONS=
