APP_NAME=IRYA API
APP_ENV=local

# 테크스펙 §2 는 /v1 이지만, 단일 도메인 배포 시 FE 라우트와 구분하기 위해 /api/v1 을 쓴다.
API_PREFIX=/api/v1

# 쉼표로 구분. FE 개발 서버는 http://localhost:5173 이다.
CORS_ORIGINS=http://localhost:5173

# 로컬 LiveKit 개발 서버 기준값. 이 키는 로컬 전용이며 비밀이 아니다.
# join 은 RoomService 를 HTTP 로 부르므로 서버가 떠 있어야 한다.
#   docker run -d --name livekit -p 7880:7880 -p 7882:7882/udp \
#     -e LIVEKIT_KEYS="devkey: devsecret_local_only_0123456789abcdef" \
#     livekit/livekit-server:v1.13.6 \
#     --bind 0.0.0.0 --node-ip 127.0.0.1 --udp-port 7882
# --udp-port 를 빼면 미디어용 UDP 가 50000~60000 대역에서 잡혀 통화가 안 붙는다.
# --node-ip 를 빼면 컨테이너 내부 IP 가 ICE 후보로 나가서 역시 안 붙는다.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_local_only_0123456789abcdef

# RoomService(Twirp) 호출 주소. 비우면 LIVEKIT_URL 을 쓴다.
# 컨테이너로 띄울 때는 compose 가 http://livekit:7880 을 넣는다 — 바로 옆
# 컨테이너를 부르려고 공개 도메인으로 나갔다 돌아올 이유가 없다.
LIVEKIT_INTERNAL_URL=

# 저장소. 비우면 인메모리로 떨어진다 (재시작하면 상태가 사라진다).
# 로컬에서 붙여 보려면:
#   docker run -d --name irya-db -p 5432:5432 \
#     -e POSTGRES_USER=irya -e POSTGRES_DB=irya -e POSTGRES_PASSWORD=devpassword \
#     postgres:17-alpine
# 스키마는 앱이 기동할 때 app/infra/schema.sql 로 적용한다.
DATABASE_URL=
