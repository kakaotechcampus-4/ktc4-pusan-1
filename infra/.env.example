# 같은 디렉터리에 `.env` 로 복사해 값을 채웁니다.
# `.env` 는 커밋되지 않고 서버에만 둡니다. 값을 이슈·PR·메신저에 붙이지 마세요.
#
# 값을 잃어버려도 전부 재발급할 수 있습니다. 아래에 출처를 적어 둡니다.

# LiveKit — 우리가 직접 정하는 값입니다.
# LiveKit 서버가 받는 "키: 시크릿" 형식은 compose 가 조립하므로 여기 적지 않습니다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PostgreSQL
# 우리가 정하는 값입니다. 잊으면 컨테이너 안에서 ALTER USER 로 재설정합니다.
POSTGRES_USER=irya
POSTGRES_DB=irya
POSTGRES_PASSWORD=

# STT — Elice Cloud 모델 라이브러리에서 발급
# 문서에는 http 로 적혀 있지만 실제로는 HTTPS 만 동작합니다.
STT_API_BASE_URL=
STT_API_KEY=

# 요약 LLM — platform.openai.com 에서 발급
OPENAI_API_KEY=
