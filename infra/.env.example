# 같은 디렉터리에 `.env` 로 복사해 값을 채웁니다.
# `.env` 는 커밋되지 않고 서버에만 둡니다. 값을 이슈·PR·메신저에 붙이지 마세요.
#
# 값을 잃어버려도 전부 재발급할 수 있습니다. 아래에 출처를 적어 둡니다.

# LiveKit — 우리가 직접 정하는 값입니다.
# LiveKit 서버가 받는 "키: 시크릿" 형식은 compose 가 조립하므로 여기 적지 않습니다.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# BE·FE 가 붙을 LiveKit 주소. 비밀이 아닙니다.
# wss:// 스킴 그대로, 포트 없이(443) 적습니다. BE 는 이 값을 FE 응답용과
# RoomService 호출용 양쪽에 쓰고, RoomService 쪽은 https:// 로 바꿔 부릅니다.
# compose 에 같은 기본값이 있어 비워 둬도 동작합니다.
LIVEKIT_URL=wss://irya.cloud

# PostgreSQL
# 우리가 정하는 값입니다. 잊으면 컨테이너 안에서 ALTER USER 로 재설정합니다.
POSTGRES_USER=irya
POSTGRES_DB=irya
POSTGRES_PASSWORD=

# STT — Elice Cloud 모델 라이브러리에서 발급
# 문서에는 http 로 적혀 있지만 실제로는 HTTPS 만 동작합니다.
# compose 에서는 `ai` 서비스(워커)만 이 값을 받습니다. 비워 두면 워커가
# STT 미설정으로 방을 떠나고, 다른 서비스 기동은 막히지 않습니다.
STT_API_BASE_URL=
STT_API_KEY=

# 요약 LLM — platform.openai.com 에서 발급
OPENAI_API_KEY=

# Agent 가 BE 의 /internal/v1 에 붙을 때 쓰는 공유 비밀. 우리가 정하는 값입니다.
# 브라우저가 쓰는 값이 아니라 컨테이너끼리만 씁니다.
#
# 비워 두면 BE 가 기동을 거부합니다(APP_ENV=production 일 때) — 인증이 꺼진 줄 모르고
# 도는 것보다 낫습니다. compose 자체는 값이 없어도 뜨므로 ps·logs 로 수습할 수 있습니다.
# ai 컨테이너가 들어오면 같은 값을 그쪽 BACKEND_API_KEY 로도 넘깁니다.
#
# 예: openssl rand -hex 32
INTERNAL_API_KEY=

# 면접이 끝난 뒤 요약을 기다리는 한도(초)입니다. 넘기면 서버가 FAILED 로 넘겨
# 요약 화면이 멈춥니다. 비워 두면 3분입니다.
#
# 3분은 AI 쪽 분석 상한(ANALYSIS_TIMEOUT_SECONDS 가 최대 120)에 결과 전송과
# 재시도 여유를 더한 값입니다. 늦게 온 결과도 받으므로, 짧게 잡아 틀리면
# 새로고침으로 복구됩니다. 요약이 실제로 얼마나 걸리는지 보고 조정하세요.
SUMMARY_TIMEOUT_SECONDS=
