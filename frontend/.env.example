# API base URL. 미설정 시 src/api/client.ts 의 기본값을 쓴다.
# BE 개발 서버 기동 후 http://localhost:8000 등으로 맞춘다.
VITE_API_BASE=

# LiveKit 서버 URL / API Key / Secret 은 FE 에 두지 않는다.
# 입장 토큰은 서버가 서명해서 POST /sessions/{id}/join 응답으로 내려준다.

# 카카오 로그인 (#126)
# REST API 키. 인가 URL 에 그대로 실려 가는 값이라 비밀이 아니다.
# 비밀인 client_secret 은 BE 에만 둔다 — 코드 → 토큰 교환은 BE 가 한다.
VITE_KAKAO_CLIENT_ID=

# 카카오 콘솔에 등록된 Redirect URI 와 글자 하나까지 같아야 한다.
# 비우면 현재 오리진 + /oauth/kakao/callback 을 쓴다.
# 로컬: http://localhost:5173/oauth/kakao/callback
# 운영: https://irya.cloud/oauth/kakao/callback
VITE_KAKAO_REDIRECT_URI=

# ── 최종 발표 데모 ────────────────────────────────────────
# 면접 화면에서 키를 누르면 준비한 지원자 답변을 주입한다 (면접관 역할만).
#
# `on` 이어도 **데모 세션에서만** 켜진다. 세션 id 는 데모 직전에 정해져 빌드에 넣을 수
# 없으므로 브라우저에 둔다. 발표 전날 다시 배포하지 않고 넣을 수 있다:
#
#   localStorage.setItem('irya.demo.sessions', JSON.stringify(['ses_abc']))
#   localStorage.setItem('irya.demo.script', JSON.stringify(['답변 한 줄', '두 줄']))
#
# 적지 않으면 아무 화면에서도 키를 잡지 않는다 — 평소 면접이 화살표를 잃지 않는다.
# 서버 쪽 DEMO_INJECTION_ENABLED·DEMO_INJECTION_SESSIONS 도 같이 맞춰야 주입된다.
VITE_DEMO_SCRIPT=
# 전진 키. 비우면 ArrowRight. KeyboardEvent.key 값을 그대로 쓴다 (예: F8, PageDown).
VITE_DEMO_SCRIPT_KEY=
