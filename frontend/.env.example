# API base URL. 미설정 시 src/api/client.ts 의 기본값을 쓴다.
# BE 개발 서버 기동 후 http://localhost:8000 등으로 맞춘다.
VITE_API_BASE=

# LiveKit 서버 URL / API Key / Secret 은 FE 에 두지 않는다.
# 입장 토큰은 서버가 서명해서 POST /sessions/{id}/join 응답으로 내려준다.

# 기본은 실제 API와 실제 LiveKit 면접이다. 시연 때만 true로 켠다.
# true이면 InterviewFlow도 목 화면을 사용한다. /mock/interview는 그대로 보존한다.
VITE_USE_MOCK_API=false

# 카카오 로그인 (#126)
# REST API 키. 인가 URL 에 그대로 실려 가는 값이라 비밀이 아니다.
# 비밀인 client_secret 은 BE 에만 둔다 — 코드 → 토큰 교환은 BE 가 한다.
VITE_KAKAO_CLIENT_ID=

# 카카오 콘솔에 등록된 Redirect URI 와 글자 하나까지 같아야 한다.
# 비우면 현재 오리진 + /oauth/kakao/callback 을 쓴다.
# 로컬: http://localhost:5173/oauth/kakao/callback
# 운영: https://irya.cloud/oauth/kakao/callback
VITE_KAKAO_REDIRECT_URI=
